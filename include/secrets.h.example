#pragma once
// Copy to include/secrets.h (git-ignored) and fill in.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// mDNS / DHCP name: the controller answers on http://office-ac.local/
#define HOSTNAME "office-ac"

// Optional shared secret. If non-empty, every /ac request must carry ?key=...
// This is plain HTTP on your LAN, so treat it as a guard against accidents,
// not as real security. Keep the device off the internet.
#define API_KEY ""
